{
  "name": "Horse Scoring Analytics",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
  "background": "#FFFFFF",
  "foreground": "#0B0B0B",
  "tableAccent": "#1F3A5F",
  "good": "#2a78d6",
  "neutral": "#F0EFEC",
  "bad": "#e34948",
  "maximum": "#0d366b",
  "center": "#F0EFEC",
  "minimum": "#e34948",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#1F3A5F" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1F3A5F" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F3A5F" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E6E5E1" } }, "radius": 6 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }] } }
  }
}
